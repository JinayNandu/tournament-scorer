rules_version = '2';

// Tournament Scorebook - Firestore security rules.
//
// Paste these into Firebase console > Firestore Database > Rules, then
// Publish. Read them first, because they decide something real.
//
// WHAT THEY SAY
//
// Anyone who opens the link can READ every tournament, live, and write
// nothing. That is the whole point: a spectator should get the scores
// with no account, no password and nothing to install.
//
// Writing takes membership, and there are three kinds:
//
//   organisers/{uid}                 may create tournaments and run every
//                                    one of them.
//   tournaments/{tid}/admins/{uid}   may run THAT tournament - its teams,
//                                    its format, its settings, its codes -
//                                    but may not create another.
//   tournaments/{tid}/scorers/{uid}  may score THAT tournament. Nothing
//                                    else: not its teams, not its format,
//                                    not its codes.
//
// THE CUT BETWEEN THE LAST TWO IS THE SHAPE OF THE PATH, and that is not
// an accident of the layout. A tournament's teams, players, groups, games
// and settings all live in the tournament DOCUMENT; its scores live in
// the fixtures and rubbers BENEATH it. So "may change this tournament" is
// write access to one document and "may score it" is write access to the
// collections under it, and there is nothing to enumerate or keep in
// step. Add a field to a tournament and it is covered already.
//
// Why bother, when the file goes on to admit that a scorer with a code
// can do real damage anyway? Because the damage differs in kind. A scorer
// entering a wrong score is Tuesday; a scorer who regenerates the draw at
// half past four has ended the tournament. Twelve people get the scoring
// code and two get the admin one.
//
// A uid comes from Firebase Anonymous sign-in, which the app does for
// everybody on load, invisibly. It is not an identity - it is a handle on
// one browser. That is enough, because what is being protected is not
// "who are you" but "has somebody given this phone the code".
//
// HOW A PHONE BECOMES A MEMBER
//
// It writes its own membership document with the code in it. The code
// itself is in a document NOBODY can read - these rules see it, clients
// never do - so the check cannot be done in the page, and a wrong code is
// simply a refused write. Checking it in JavaScript would mean shipping
// the code to everyone who opens the app, which is not a check at all.
//
// The code stays in the membership document, which is why those documents
// are readable only by the member themselves and by organisers. Do not
// loosen that to `if true` for a "who is scoring" list; the list is not
// worth the code.
//
// THE FIRST ORGANISER
//
// A brand new database has no organiser key, and while that is true any
// signed-in phone may make itself an organiser. The app does this on
// first run and then writes the key, which shuts the door. The window is
// the one between creating the Firebase project and first opening the
// app - before the link has been given to anybody - so in practice it is
// already shut. If that is not good enough, create
// `access/config` with an `organiserCode` field by hand in the console
// BEFORE opening the app, and the door is never open at all.
//
// The two writes are deliberately in this order - membership first, key
// second. The other way round, a failure between them would leave a
// database with a key nobody holds and no way to set one: locked, for
// good, with no message to say why.
//
// WHAT IS STILL NOT PROTECTED
//
// Anyone with a tournament's scoring code can enter a wrong score or
// delete a match, and the rules cannot tell a scorer from someone they
// read the code out to. That is the same trust as handing over a paper
// scoresheet. The scoring lease in store.js is cooperative for the same
// reason: the real problem is two well-meaning scorers, not an attacker.
//
// And every tournament is still world-readable. Scores on a wall are the
// point; if that ever stops being true, it is this file that has to say
// so, and nothing in the app relies on the secrecy of anything it shows.
//
// Anything not matched below is denied. That is Firestore's default and
// it is left to stand, which means a collection added to the app later
// will be refused until it is added here too. That is the right way
// round.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function noKeyYet() {
      return !exists(/databases/$(database)/documents/access/config);
    }

    function organiserCode() {
      return get(/databases/$(database)/documents/access/config).data.organiserCode;
    }

    function scorerCode(tid) {
      return get(/databases/$(database)/documents/tournaments/$(tid)/access/code).data.scorerCode;
    }

    function adminCode(tid) {
      return get(/databases/$(database)/documents/tournaments/$(tid)/access/admin).data.adminCode;
    }

    function isOrganiser() {
      return signedIn() &&
        exists(/databases/$(database)/documents/organisers/$(request.auth.uid));
    }

    function isAdmin(tid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/tournaments/$(tid)/admins/$(request.auth.uid));
    }

    function isScorer(tid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/tournaments/$(tid)/scorers/$(request.auth.uid));
    }

    // Everything about one tournament except bringing it into existence.
    function mayManage(tid) {
      return isOrganiser() || isAdmin(tid);
    }

    // Managing is a superset of scoring, always. Nobody is put in charge
    // of a tournament they are then refused permission to score.
    function mayScore(tid) {
      return mayManage(tid) || isScorer(tid);
    }

    // ---- the organiser key ------------------------------------------
    // Read by nobody. These rules read it; that is not the same thing.
    match /access/config {
      allow read: if false;
      allow create: if signedIn() && noKeyYet();
      allow update: if isOrganiser();
      allow delete: if false;
    }

    // ---- who the organisers are --------------------------------------
    // The document holds the key that was typed, so only its owner and
    // the other organisers may read it.
    match /organisers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOrganiser());
      allow create: if signedIn() && request.auth.uid == uid &&
                       (noKeyYet() || request.resource.data.code == organiserCode());
      allow update: if false;
      allow delete: if isOrganiser();
    }

    // ---- one tournament's scoring code -------------------------------
    // Everybody who may score may read it, which includes the scorers
    // themselves: it is the code they already typed.
    match /tournaments/{tid}/access/code {
      allow read: if mayScore(tid);
      allow write: if mayManage(tid);
    }

    // ---- one tournament's admin code ---------------------------------
    // A SEPARATE DOCUMENT, and that is the whole reason it works. Put
    // both codes in one document and anyone who may read the scoring code
    // reads the admin code beside it, which hands every scorer the keys
    // and makes two codes worse than one. Whoever already runs this
    // tournament may read it, because they have to say it out loud to the
    // person they are handing it to.
    match /tournaments/{tid}/access/admin {
      allow read: if mayManage(tid);
      allow write: if mayManage(tid);
    }

    // ---- who runs one tournament -------------------------------------
    // Same shape as scorers below, against the other code. An admin can
    // hand their own access back; taking somebody else's needs the
    // organiser, so that two admins cannot lock each other out.
    match /tournaments/{tid}/admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || mayManage(tid));
      allow create: if signedIn() && request.auth.uid == uid &&
                       request.resource.data.code == adminCode(tid);
      allow update: if false;
      allow delete: if isOrganiser() || (signedIn() && request.auth.uid == uid);
    }

    // ---- who may score one tournament --------------------------------
    match /tournaments/{tid}/scorers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || mayScore(tid));
      allow create: if signedIn() && request.auth.uid == uid &&
                       request.resource.data.code == scorerCode(tid);
      allow update: if false;
      // Whoever runs the tournament takes access away; a scorer can
      // hand it back.
      allow delete: if mayManage(tid) || (signedIn() && request.auth.uid == uid);
    }

    // ---- the tournaments themselves ----------------------------------
    // The document itself is the tournament's SHAPE - name, teams,
    // players, groups, stages, the games a match is made of, the scoring
    // settings. A scoring code does not reach it. See the note at the top
    // of this file: this one line is the whole difference between the two
    // codes, and the scores are safe underneath it either way.
    match /tournaments/{tid} {
      allow read: if true;
      allow create: if isOrganiser();
      allow update: if mayManage(tid);
      allow delete: if mayManage(tid);
    }

    // ---- what a tournament is made of --------------------------------
    // Named one at a time rather than with a wildcard, because a
    // wildcard would also match `access` and `scorers` above - and in
    // these rules ANY matching allow wins, so one `read: if true` on a
    // wildcard would hand out every code in the database.
    match /tournaments/{tid}/fixtures/{fixtureId} {
      allow read: if true;
      allow write: if mayScore(tid);
    }

    match /tournaments/{tid}/rubbers/{rubberId} {
      allow read: if true;
      allow write: if mayScore(tid);
    }

    // The cooperative scoring lease. Read openly so a second phone can
    // see who holds a court before it offers to take over.
    match /tournaments/{tid}/leases/{rubberId} {
      allow read: if true;
      allow write: if mayScore(tid);
    }
  }
}
